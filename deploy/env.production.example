# Production environment for the EC2 instance.
# Copy to the repo root as `.env` on the server and never commit it.
#
#   cp deploy/env.production.example .env && nano .env && chmod 600 .env

# Server
PORT=8080
NODE_ENV=production

# Database (Aiven PostgreSQL).
# IMPORTANT: sslrootcert must point at the copy of ca.pem inside the image
# ("/app" is the container WORKDIR) — not at a Windows path.
DATABASE_URL="postgresql://avnadmin:PASSWORD@pg-demoservice-sany-phonex.f.aivencloud.com:19550/defaultdb?sslmode=require&sslrootcert=./ca.pem"

# JWT — generate each with `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_me_with_64_hex_chars
JWT_REFRESH_SECRET=replace_me_with_64_hex_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_live_or_test_key
RAZORPAY_KEY_SECRET=razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret

# CORS — the exact frontend origin, no trailing slash.
# Multiple origins are not supported by the current config.
CORS_ORIGIN=https://your-frontend-domain

# Rate limiting (per IP). A frontend build costs ~66 requests, so keep this
# comfortably above what one build plus a few users need.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MINUTES=15

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
